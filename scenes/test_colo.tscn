[node name="ZoomArea2" parent="." unique_id=1700831280 instance=ExtResource("3_p6wxt")]
layout_mode = 1
offset_left = 75.0
offset_top = 21.0
offset_right = 75.0
offset_bottom = 21.0
scale = Vector2(0.475, 0.475)
text = "La première fois que j’ai vu Wei, je ne l’ai même pas calculée. Elle traînait énormément avec Xin et je me suis donc mis à la découvrir au fur et à mesure qu’on traînait ensemble. Elle est courageuse, persévérante et furieusement rebelle. Elle avait aussi des défauts, bien sûr : elle était grincheuse et pouvait être une vraie tête de mule. Mais c’est aussi ce qui faisait son charme. De plus, nous partagions une passion commune : le dessin. On s’était promis de postuler ensemble aux Beaux-Arts de Paris à nos 18 ans. Je lui avais tricoté et offert ce pull, qui illustre ce qu’elle représentait pour moi."
metadata/_edit_lock_ = true
